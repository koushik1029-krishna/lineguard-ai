{
  "name": "lineguard-ai",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w lineguard-server",
    "dev:client": "npm run dev -w lineguard-client",
    "dev": "concurrently -n api,web -c cyan,magenta npm:dev:server npm:dev:client",
    "build": "npm run build -w lineguard-client",
    "start": "npm run start -w lineguard-server",
    "seed": "npm run seed -w lineguard-server",
    "test": "npm run test -w lineguard-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
