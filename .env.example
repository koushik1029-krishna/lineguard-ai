# LineGuard API port.
PORT=3001

# SQLite database file. Relative paths are resolved from the server package.
DATABASE_PATH=./data/lineguard.db

# Leave this blank to keep the troubleshooting panel in demo mode.
# Demo mode does not call a model and does not invent an AI answer.
OPENAI_API_KEY=

# Used only when OPENAI_API_KEY is set to a real key.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
